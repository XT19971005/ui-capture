# Put this directive in http {}, before the existing HTTPS server block.
# Omit query strings, Referer, cookies and authorization headers.
log_format shijie_safe '$remote_addr [$time_local] $request_method $uri '
                       '$status $body_bytes_sent $request_time';

# Put the following locations inside that HTTPS server; keep the prefix unchanged.
location = /shijie {
    access_log /var/log/nginx/shijie-access.log shijie_safe;
    absolute_redirect off;
    return 302 /shijie/;
}
# Desktop relay uses its own paired bearer credential. Do not inherit an
# interactive gateway login here; Django still validates every relay request.
location ^~ /shijie/desktop-relay/v1/ {
    access_log /var/log/nginx/shijie-access.log shijie_safe;
    auth_request off;
    auth_basic off;
    proxy_pass http://127.0.0.1:8093;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;
    client_max_body_size 276m;
    proxy_read_timeout 120s;
    proxy_request_buffering off;
}
location /shijie/ {
    access_log /var/log/nginx/shijie-access.log shijie_safe;
    proxy_pass http://127.0.0.1:8093;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;
    client_max_body_size 276m;
    proxy_read_timeout 120s;
    proxy_request_buffering off;
    # nginx error logs can include the original callback query on upstream errors.
    # Keep route/status/timing in the safe access log; suppress auth error details.
    location ^~ /shijie/auth/ {
        proxy_pass http://127.0.0.1:8093;
        error_log /dev/null;
    }
}
