{
  "manifest_version": 3,
  "name": "拾界 · UI Capture",
  "version": "0.8.0",
  "description": "抓取网页，编辑图层、文字与矢量，导出 Figma 插件数据、分层 PSD、SVG 和 PNG。Designed by XT。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/shijie-16.png",
      "32": "icons/shijie-32.png"
    },
    "default_title": "拾界 · 抓取并编辑图层"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "icons": {
    "16": "icons/shijie-16.png",
    "32": "icons/shijie-32.png",
    "48": "icons/shijie-48.png",
    "128": "icons/shijie-128.png"
  },
  "author": "XT"
}
